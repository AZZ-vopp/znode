diff --git a/proxy/wireguard/netstack_test.go b/proxy/wireguard/netstack_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/wireguard/netstack_test.go
@@ -0,0 +1,55 @@
+package wireguard
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestNetCanReachDNSServer(t *testing.T) {
+	ipv4DNS := netip.MustParseAddr("1.1.1.1")
+	ipv6DNS := netip.MustParseAddr("2606:4700:4700::1111")
+
+	tests := []struct {
+		name     string
+		net      *Net
+		server   netip.Addr
+		reachable bool
+	}{
+		{
+			name:      "IPv4 tunnel accepts IPv4 DNS",
+			net:       &Net{hasV4: true},
+			server:    ipv4DNS,
+			reachable: true,
+		},
+		{
+			name:   "IPv4 tunnel rejects IPv6 DNS",
+			net:    &Net{hasV4: true},
+			server: ipv6DNS,
+		},
+		{
+			name:      "IPv6 tunnel accepts IPv6 DNS",
+			net:       &Net{hasV6: true},
+			server:    ipv6DNS,
+			reachable: true,
+		},
+		{
+			name:   "IPv6 tunnel rejects IPv4 DNS",
+			net:    &Net{hasV6: true},
+			server: ipv4DNS,
+		},
+		{
+			name:      "dual-stack tunnel accepts IPv6 DNS",
+			net:       &Net{hasV4: true, hasV6: true},
+			server:    ipv6DNS,
+			reachable: true,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := test.net.canReachDNSServer(test.server); got != test.reachable {
+				t.Fatalf("canReachDNSServer(%s) = %t, want %t", test.server, got, test.reachable)
+			}
+		})
+	}
+}
